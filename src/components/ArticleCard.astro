---
import { formatDate } from '../data/content';
interface Props { href: string; kicker: string; title: string; excerpt: string; date?: string; tags?: string[]; level?: 'h2' | 'h3' }
const { href, kicker, title, excerpt, date, tags = [], level = 'h3' } = Astro.props;
const Heading = level;
---

<a href={href} class="card lift group flex h-full flex-col p-6">
  <div class="flex items-center justify-between gap-3 text-[12px] font-semibold uppercase tracking-[0.12em] text-ink-500">
    <span class="rounded-full bg-brand-50 px-2.5 py-1 normal-case tracking-normal text-brand-700">{kicker}</span>
    {date && <time datetime={date}>{formatDate(date)}</time>}
  </div>
  <Heading class="mt-4 font-sans text-[17px] font-semibold leading-snug text-ink-900 group-hover:text-brand-700">{title}</Heading>
  <p class="mt-2 line-clamp-3 text-[14px] leading-relaxed text-ink-600">{excerpt}</p>
  {tags.length > 0 && <ul class="mt-4 flex flex-wrap gap-1.5">{tags.slice(0, 3).map((t) => <li class="rounded-full bg-ink-50 px-2.5 py-0.5 text-[11.5px] font-medium text-ink-600">{t}</li>)}</ul>}
  <span class="mt-auto inline-flex items-center gap-1.5 pt-5 text-[14px] font-semibold text-brand-600">Read <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="transition group-hover:translate-x-1"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
</a>
