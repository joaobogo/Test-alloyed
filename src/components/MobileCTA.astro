---
// Slim bottom bar on phones only. Appears after the first screen, hides when a
// form is in view or the menu is open, respects the home-indicator safe area.
---

<div id="mobile-cta" class="mobile-cta fixed inset-x-3 bottom-3 z-40 sm:hidden" hidden>
  <a href="/contact/" class="btn-ember w-full !py-3.5 shadow-[0_16px_40px_-12px_rgba(255,107,0,.7)]">Talk to an operations expert
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>
</div>

<style>
  .mobile-cta { padding-bottom: env(safe-area-inset-bottom, 0px); transition: transform .35s cubic-bezier(.2,.7,.2,1), opacity .35s; }
  .mobile-cta[data-off] { transform: translateY(120%); opacity: 0; pointer-events: none; }
  :root.menu-open .mobile-cta { transform: translateY(120%); opacity: 0; }
</style>

<script>
  const init = () => {
    const bar = document.getElementById('mobile-cta');
    if (!bar) return;
    bar.hidden = false; bar.setAttribute('data-off', '');
    if (!matchMedia('(max-width: 639px)').matches) return; // desktop never needs the observers
    // Two observers, zero layout reads on scroll: one tracks forms/footer, one
    // tracks a sentinel at 80% of the first screen.
    const visibleForms = new Set<Element>();
    let past = false, shown = false;
    const apply = () => { const next = past && visibleForms.size === 0; if (next !== shown) { shown = next; next ? bar.removeAttribute('data-off') : bar.setAttribute('data-off', ''); } };
    const fio = new IntersectionObserver((es) => { es.forEach((e) => (e.isIntersecting ? visibleForms.add(e.target) : visibleForms.delete(e.target))); apply(); });
    document.querySelectorAll('form, #contact, footer').forEach((f) => fio.observe(f));
    const sentinel = document.createElement('div'); sentinel.setAttribute('aria-hidden', 'true'); sentinel.style.cssText = 'position:absolute;top:80vh;left:0;width:1px;height:1px;pointer-events:none';
    document.body.prepend(sentinel);
    const sio = new IntersectionObserver(([e]) => { past = e.boundingClientRect.top < 0; apply(); });
    sio.observe(sentinel);
    document.addEventListener('astro:before-swap', () => { fio.disconnect(); sio.disconnect(); sentinel.remove(); }, { once: true });
  };
  document.addEventListener('astro:page-load', init);
</script>
