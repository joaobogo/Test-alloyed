---
import { stats } from '../data/site';
interface Props { dark?: boolean; notes?: boolean }
const { dark = false, notes = true } = Astro.props;
---

<dl class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-ink-100 bg-ink-100 lg:grid-cols-4" class:list={[dark && '!border-white/10 !bg-white/10']}>
  {stats.map((s) => (
    <div class:list={['p-6 sm:p-8', dark ? 'bg-ink-900' : 'bg-white']}>
      <dd class:list={['h-display text-[40px] sm:text-[52px]', dark ? 'text-white' : 'text-ink-900']}>
        <span data-count={s.value} data-decimals={s.decimals ?? 0} data-suffix={s.suffix}>{s.value}{s.suffix}</span>
      </dd>
      <dt class:list={['mt-1 text-[14px] font-semibold', dark ? 'text-white/85' : 'text-ink-800']}>{s.label}</dt>
      {notes && <p class:list={['mt-2 text-[13px] leading-relaxed', dark ? 'text-white/50' : 'text-ink-500']}>{s.note}</p>}
    </div>
  ))}
</dl>
