---
import { nav } from '../data/site';
interface Props { dark?: boolean }
const { dark = true } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header
  id="site-header"
  class:list={[
    'sticky top-0 z-50 border-b backdrop-blur-xl transition-colors',
    dark ? 'bg-ink-900/85 border-white/10 text-white' : 'bg-white/85 border-ink-100 text-ink-900',
  ]}
>
  <div class="container-x flex h-[72px] items-center justify-between gap-6">
    <a href="/" class="flex shrink-0 items-center" aria-label="Alloyed home">
      <img src={dark ? '/logo-white.svg' : '/logo.svg'} alt="Alloyed" width="142" height="32" class="h-8 w-auto" />
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label="Primary">
      {nav.map((item) => (
        <div class="group relative">
          <a
            href={item.href}
            class:list={[
              'flex items-center gap-1 rounded-md px-3 py-2 text-[14.5px] font-medium transition',
              dark ? 'text-white/80 hover:text-white hover:bg-white/5' : 'text-ink-700 hover:text-ink-900 hover:bg-ink-50',
              isActive(item.href) && (dark ? 'text-white' : 'text-ink-900'),
            ]}
            aria-haspopup={item.children ? 'true' : undefined}
          >
            {item.label}
            {item.children && (
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" class="opacity-60"><path d="M2.5 4.5l3.5 3.5 3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            )}
          </a>
          {item.children && (
            <div class="invisible absolute left-0 top-full pt-2 opacity-0 transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
              <ul class="card min-w-[280px] p-2 text-ink-900">
                {item.children.map((c) => (
                  <li>
                    <a href={c.href} class="block rounded-lg px-3 py-2.5 text-[14px] font-medium text-ink-700 hover:bg-brand-50 hover:text-brand-700">{c.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href="/contact/" class="hidden sm:inline-flex btn-ember !py-2.5 !px-4 text-[14px]">Talk to an operations expert</a>
      <button
        id="nav-toggle"
        class:list={['lg:hidden inline-flex h-10 w-10 items-center justify-center rounded-md', dark ? 'text-white hover:bg-white/10' : 'text-ink-900 hover:bg-ink-50']}
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" hidden class="lg:hidden border-t border-white/10 bg-ink-900 text-white">
    <nav class="container-x py-4" aria-label="Mobile">
      {nav.map((item) => (
        item.children ? (
          <details class="border-b border-white/10 py-1" open={isActive(item.href)}>
            <summary class="flex cursor-pointer items-center justify-between py-3 text-[16px] font-semibold">
              {item.label}
              <svg width="14" height="14" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 4.5l3.5 3.5 3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </summary>
            <ul class="pb-3 pl-3">
              <li><a href={item.href} class="block py-2 text-[15px] font-semibold text-white">All {item.label.toLowerCase()}</a></li>
              {item.children.map((c) => (
                <li><a href={c.href} class="block py-2 text-[15px] text-white/80">{c.label}</a></li>
              ))}
            </ul>
          </details>
        ) : (
          <a href={item.href} class="block border-b border-white/10 py-4 text-[16px] font-semibold">{item.label}</a>
        )
      ))}
      <div class="mt-4 grid gap-3">
        <a href="/contact/" class="btn-ember w-full">Talk to an operations expert</a>
        <a href="tel:+18565562200" class="btn-ghost-light w-full">Call +1 (856) 556-2200</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = panel!.hasAttribute('hidden');
    if (open) panel!.removeAttribute('hidden'); else panel!.setAttribute('hidden', '');
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>
