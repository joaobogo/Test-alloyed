---
import { nav } from '../data/site';
interface Props { dark?: boolean }
const { dark = true } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header
  id="site-header"
  class:list={[
    'sticky top-0 z-50 border-b backdrop-blur-xl transition-colors',
    dark ? 'bg-ink-900/85 border-white/10 text-white' : 'bg-white/85 border-ink-100 text-ink-900',
  ]}
>
  <div class="container-x flex h-[72px] items-center justify-between gap-6">
    <a href="/" class="flex shrink-0 items-center" aria-label="Alloyed home">
      <img src={dark ? '/logo-white.svg' : '/logo.svg'} alt="Alloyed" width="142" height="32" class="h-8 w-auto" />
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label="Primary">
      {nav.map((item) => (
        <div class="group relative">
          <a
            href={item.href}
            class:list={[
              'flex items-center gap-1 rounded-md px-3 py-2 text-[14.5px] font-medium transition',
              dark ? 'text-white/80 hover:text-white hover:bg-white/5' : 'text-ink-700 hover:text-ink-900 hover:bg-ink-50',
              isActive(item.href) && (dark ? 'text-white' : 'text-ink-900'),
            ]}
            aria-haspopup={item.children ? 'true' : undefined}
          >
            {item.label}
            {item.children && (
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" class="opacity-60 transition group-hover:rotate-180"><path d="M2.5 4.5l3.5 3.5 3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            )}
          </a>
          {item.children && (
            <div class="invisible absolute left-0 top-full pt-2 opacity-0 translate-y-1 transition duration-200 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0">
              <ul class="card min-w-[280px] p-2 text-ink-900">
                {item.children.map((c) => (
                  <li>
                    <a href={c.href} class="block rounded-lg px-3 py-2.5 text-[14px] font-medium text-ink-700 hover:bg-brand-50 hover:text-brand-700">{c.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href="/contact/" class="hidden sm:inline-flex btn-ember !py-2.5 !px-4 text-[14px]">Talk to an operations expert</a>
      <button
        id="nav-toggle"
        class:list={['lg:hidden relative inline-flex h-10 w-10 items-center justify-center rounded-md', dark ? 'text-white hover:bg-white/10' : 'text-ink-900 hover:bg-ink-50']}
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <span class="burger" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div id="mobile-nav" hidden class="mobile-nav lg:hidden fixed inset-x-0 bottom-0 top-[72px] z-40 overflow-y-auto bg-ink-900 text-white">
    <nav class="container-x flex min-h-full flex-col py-6" aria-label="Mobile">
      <div class="flex-1">
        {nav.map((item, i) => (
          item.children ? (
            <details class="mobile-item border-b border-white/10" style={`--i:${i}`} open={isActive(item.href)}>
              <summary class="flex cursor-pointer items-center justify-between py-4 text-[22px] font-semibold">
                {item.label}
                <svg width="16" height="16" viewBox="0 0 12 12" fill="none" aria-hidden="true" class="transition"><path d="M2.5 4.5l3.5 3.5 3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              </summary>
              <ul class="pb-4">
                <li><a href={item.href} class="block py-2 text-[16px] font-semibold text-ember-400">All {item.label.toLowerCase()} →</a></li>
                {item.children.map((c) => (
                  <li><a href={c.href} class="block py-2 text-[16px] text-white/80">{c.label}</a></li>
                ))}
              </ul>
            </details>
          ) : (
            <a href={item.href} class="mobile-item block border-b border-white/10 py-4 text-[22px] font-semibold" style={`--i:${i}`}>{item.label}</a>
          )
        ))}
      </div>
      <div class="mobile-item mt-8 grid gap-3 pb-8" style="--i:6">
        <a href="/contact/" class="btn-ember w-full !py-4 text-[16px]">Talk to an operations expert</a>
        <a href="tel:+18565562200" class="btn-ghost-light w-full !py-4 text-[16px]">Call +1 (856) 556-2200</a>
        <p class="text-center text-[12.5px] text-white/60">Monday to Friday, 8:30 AM to 5:30 PM ET</p>
      </div>
    </nav>
  </div>
</header>

<style>
  .burger { display: grid; gap: 5px; width: 22px; }
  .burger span { display: block; height: 2px; border-radius: 2px; background: currentColor; transition: transform .3s cubic-bezier(.2,.7,.2,1), opacity .2s; transform-origin: center; }
  [aria-expanded="true"] .burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  [aria-expanded="true"] .burger span:nth-child(2) { opacity: 0; }
  [aria-expanded="true"] .burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .mobile-item { animation: mobile-in .5s cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(var(--i, 0) * 45ms); }
  @keyframes mobile-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  details[open] summary svg { transform: rotate(180deg); }
  @media (prefers-reduced-motion: reduce) { .mobile-item { animation: none; } .burger span { transition: none; } }
</style>

<script>
  const init = () => {
    const btn = document.getElementById('nav-toggle');
    const panel = document.getElementById('mobile-nav');
    if (!btn || !panel) return;
    const set = (open: boolean) => {
      panel.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.documentElement.classList.toggle('overflow-hidden', open);
      document.documentElement.classList.toggle('menu-open', open);
    };
    btn.addEventListener('click', () => set(panel.hidden));
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) set(false); });
    matchMedia('(min-width: 1024px)').addEventListener('change', (e) => { if (e.matches) set(false); });
  };
  document.addEventListener('astro:page-load', init);
</script>
