---
// Shared template for perspectives and news releases.
import Base from './Base.astro';
import CTA from '../components/CTA.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { renderMarkdown, formatDate, readingTime, authorFor, type Article } from '../data/content';
import { site } from '../data/site';

interface Props { article: Article; kind: 'Perspective' | 'News'; basePath: string; related: Article[] }
const { article: a, kind, basePath, related } = Astro.props;
const html = renderMarkdown(a.bodyMarkdown);
const author = authorFor(a);
const url = `${site.url}${basePath}${a.slug}/`;
const title = a.title.length > 58 ? `${a.title.slice(0, 55).trim()}… | Alloyed` : `${a.title} | Alloyed`;
const schema = [{
  '@context': 'https://schema.org',
  '@type': kind === 'News' ? 'NewsArticle' : 'Article',
  headline: a.title,
  description: a.excerpt,
  datePublished: a.date,
  dateModified: a.date,
  author: kind === 'News' ? { '@id': `${site.url}/#organization` } : { '@type': author.name === 'Lauren Kochan' ? 'Person' : 'Organization', name: author.name, ...(author.name === 'Lauren Kochan' ? { jobTitle: 'Chief Executive Officer', worksFor: { '@id': `${site.url}/#organization` } } : {}) },
  publisher: { '@id': `${site.url}/#organization` },
  mainEntityOfPage: url,
  keywords: a.tags.join(', '),
}];
const crumbs = [{ name: 'Insights', href: '/insights/' }, { name: kind === 'News' ? 'News' : 'Perspectives', href: basePath }, { name: a.title, href: `${basePath}${a.slug}/` }];
---

<Base title={title} description={a.excerpt.slice(0, 158)} ogType="article" schema={schema} breadcrumbs={crumbs}>
  <article>
    <header class="relative overflow-hidden bg-ink-900 py-16 text-white sm:py-20">
      <div class="absolute inset-0 grid-bg opacity-30" aria-hidden="true"></div>
      <div class="container-x relative max-w-4xl">
        <nav aria-label="Breadcrumb" class="text-[13px] text-white/60"><a href="/" class="hover:text-white">Home</a> <span class="mx-1.5">/</span> <a href="/insights/" class="hover:text-white">Insights</a> <span class="mx-1.5">/</span> <a href={basePath} class="hover:text-white">{kind === 'News' ? 'News' : 'Perspectives'}</a></nav>
        <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-[13px] text-white/70">
          <span class="rounded-full bg-white/10 px-2.5 py-1 font-semibold text-white">{kind}</span>
          <time datetime={a.date}>{formatDate(a.date, kind === 'News' ? { month: 'long', day: 'numeric', year: 'numeric' } : undefined)}</time>
          <span aria-hidden="true">·</span><span>{readingTime(a.bodyMarkdown)}</span>
          {a.tags.filter((t) => t !== 'News').map((t) => <span class="rounded-full border border-white/15 px-2.5 py-0.5">{t}</span>)}
        </div>
        <h1 class="h-display mt-5 text-[34px] text-white sm:text-[48px]">{a.title}</h1>
        <p class="mt-5 max-w-[66ch] text-[17px] leading-relaxed text-white/75">{a.excerpt}</p>
        <div class="mt-8 flex items-center gap-3">
          <span class="flex h-11 w-11 items-center justify-center rounded-full bg-ember-500 font-display text-[15px] font-bold text-ink-950" aria-hidden="true">{author.name.split(' ').map((w) => w[0]).slice(0, 2).join('')}</span>
          <div class="text-[14px]"><p class="font-semibold text-white">{author.name}</p><p class="text-white/60">{author.role}</p></div>
        </div>
      </div>
    </header>

    <div class="container-x grid gap-12 py-14 lg:grid-cols-12">
      <div class="prose-alloyed lg:col-span-8" set:html={html} />
      <aside class="lg:col-span-4">
        <div class="sticky top-24 space-y-4">
          {a.pdf && <a href={a.pdf} class="card flex items-center gap-4 p-5 hover:border-brand-200" rel="noopener"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span><span class="block text-[15px] font-semibold text-ink-900">Download the brief</span><span class="text-[13px] text-ink-500">PDF</span></span></a>}
          <div class="card p-6">
            <p class="eyebrow">Put this to work</p>
            <h2 class="mt-2 text-[22px] font-bold">Map one workflow with us.</h2>
            <p class="mt-2 text-[14px] text-ink-600">A 30-minute working session with an operations expert: we size the opportunity and tell you whether Alloyed is the right fit.</p>
            <a href="#contact" class="btn-ember mt-5 w-full">Talk to an operations expert</a>
          </div>
          <div class="card p-6">
            <p class="eyebrow">Share</p>
            <div class="mt-3 flex gap-2">
              <a class="btn-ghost !px-3 !py-2 text-[13px]" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener">LinkedIn</a>
              <a class="btn-ghost !px-3 !py-2 text-[13px]" href={`mailto:?subject=${encodeURIComponent(a.title)}&body=${encodeURIComponent(url)}`}>Email</a>
              <button type="button" class="btn-ghost !px-3 !py-2 text-[13px]" data-copy={url}>Copy link</button>
            </div>
          </div>
        </div>
      </aside>
    </div>

    {related.length > 0 && (
      <section class="bg-ink-50 py-16">
        <div class="container-x">
          <p class="eyebrow">Keep reading</p>
          <div class="mt-6 grid gap-5 md:grid-cols-3">{related.map((r) => <ArticleCard href={`${basePath}${r.slug}/`} kicker={kind} title={r.title} excerpt={r.excerpt} date={r.date} tags={r.tags.filter((t) => t !== 'News')} />)}</div>
        </div>
      </section>
    )}
  </article>
  <CTA interest={`${kind}: ${a.title}`} />
  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => { try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = 'Copied'; setTimeout(() => (b.textContent = 'Copy link'), 1500); } catch {} }));
  </script>
</Base>
