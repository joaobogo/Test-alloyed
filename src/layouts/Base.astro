---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Consent from '../components/Consent.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  breadcrumbs?: { name: string; href: string }[];
  dark?: boolean;
  ogImage?: string;
  lang?: string;
}

const { title, description, ogType = 'website', noindex = false, schema = [], breadcrumbs = [], dark = true, ogImage: og = '/og-default.png', lang = 'en' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(og, Astro.site).href;

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  legalName: site.legalName,
  alternateName: ['SEBPO', 'Alloyed Solutions', 'Alloyed (formerly SEBPO)'],
  url: site.url,
  logo: `${site.url}/logo.svg`,
  foundingDate: String(site.founded),
  description: site.description,
  email: site.email,
  telephone: site.phone,
  address: { '@type': 'PostalAddress', addressLocality: site.hq.city, addressRegion: site.hq.region, addressCountry: site.hq.country },
  sameAs: [site.linkedin],
  numberOfEmployees: { '@type': 'QuantitativeValue', minValue: 1000, maxValue: 1500 },
  award: ['IAOP Global Outsourcing 100', 'Inc. 5000'],
  areaServed: ['US', 'CA', 'GB', 'EU'],
  knowsAbout: ['Ad operations outsourcing', 'Media billing', 'AML and KYC operations', 'Data engineering', 'Customer engagement', 'Business process outsourcing'],
};

const crumbs =
  breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [{ name: 'Home', href: '/' }, ...breadcrumbs].map((b, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.name,
          item: new URL(b.href, Astro.site).href,
        })),
      }
    : null;

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  url: site.url,
  name: site.name,
  publisher: { '@id': `${site.url}/#organization` },
};
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0b1020" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Alloyed" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    <script type="application/ld+json" set:html={JSON.stringify(website)} />
    {crumbs && <script type="application/ld+json" set:html={JSON.stringify(crumbs)} />}
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />

    <script is:inline>
      document.documentElement.classList.remove('no-js');
      // Google Consent Mode v2: everything denied until the visitor chooses.
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
        analytics_storage: 'denied', functionality_storage: 'granted', security_storage: 'granted',
        wait_for_update: 500,
      });
      try {
        var c = JSON.parse(localStorage.getItem('alloyed-consent') || 'null');
        if (c && c.analytics) gtag('consent', 'update', { analytics_storage: 'granted', ad_storage: c.ads ? 'granted' : 'denied', ad_user_data: c.ads ? 'granted' : 'denied', ad_personalization: c.ads ? 'granted' : 'denied' });
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-md focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-white">Skip to content</a>
    <Header dark={dark} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <Consent />

    <script>
      // Reveal-on-scroll and decorative count-up. All content exists in HTML before this runs.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.1 }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce) {
        const cio = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const el = e.target as HTMLElement;
            cio.unobserve(el);
            const end = parseFloat(el.dataset.count || '0');
            const dec = parseInt(el.dataset.decimals || '0', 10);
            const suffix = el.dataset.suffix || '';
            const t0 = performance.now();
            const dur = 1100;
            const tick = (t: number) => {
              const p = Math.min(1, (t - t0) / dur);
              const v = end * (1 - Math.pow(1 - p, 3));
              el.textContent = v.toFixed(dec) + suffix;
              if (p < 1) requestAnimationFrame(tick);
              else el.textContent = end.toFixed(dec) + suffix;
            };
            requestAnimationFrame(tick);
          }
        }, { threshold: 0.5 });
        document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => cio.observe(el));
      }

      // Capture lead source once per session for the contact form hidden fields.
      try {
        const p = new URLSearchParams(location.search);
        const keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'gclid', 'li_fat_id', 'fbclid'];
        const found: Record<string, string> = {};
        keys.forEach((k) => { const v = p.get(k); if (v) found[k] = v; });
        if (Object.keys(found).length) sessionStorage.setItem('alloyed-src', JSON.stringify({ ...found, landing: location.pathname, referrer: document.referrer }));
        else if (!sessionStorage.getItem('alloyed-src')) sessionStorage.setItem('alloyed-src', JSON.stringify({ landing: location.pathname, referrer: document.referrer }));
      } catch {}
    </script>
  </body>
</html>
