---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import StatBand from '../../components/StatBand.astro';
import { services, engagementModels } from '../../data/site';
---

<Base title="Services: Ad Ops, Finance, Compliance, Data & CX Outsourcing | Alloyed" description="Six managed operations practices from Alloyed (formerly SEBPO): ad operations, finance and accounting, AML/KYC compliance, data and analytics, customer engagement and operational excellence." breadcrumbs={[{ name: 'Services', href: '/services/' }]}>
  <section class="bg-ink-900 py-20 text-white sm:py-24">
    <div class="container-x">
      <p class="eyebrow-light">Services</p>
      <h1 class="h-display mt-3 max-w-[16ch] text-[42px] text-white sm:text-[60px]">Operations practices built for volume, accuracy and deadlines.</h1>
      <p class="mt-5 max-w-[60ch] text-[17px] text-white/75">Start with one workflow or hand off an entire function. Every practice runs on dedicated teams, documented process and outcome SLAs.</p>
    </div>
  </section>
  <section class="py-16">
    <div class="container-x grid gap-5 md:grid-cols-2">
      {services.map((s, i) => (
        <a href={`/services/${s.slug}/`} class="card group reveal p-7 hover:border-brand-200">
          <div class="flex items-start justify-between gap-4">
            <div><span class="font-display text-[13px] font-bold tracking-widest text-ember-700">0{i + 1}</span><h2 class="mt-2 text-[26px] font-bold group-hover:text-brand-700">{s.name}</h2></div>
            <span class="h-display text-[30px] text-brand-600">{s.outcomes[0].value}</span>
          </div>
          <p class="mt-3 text-[15px] leading-relaxed text-ink-600">{s.intro}</p>
          <ul class="mt-5 flex flex-wrap gap-2">{s.capabilities.map((c) => <li class="rounded-full bg-ink-50 px-3 py-1 text-[12.5px] font-medium text-ink-700">{c.title}</li>)}</ul>
        </a>
      ))}
    </div>
  </section>
  <section class="bg-ink-50 py-16">
    <div class="container-x">
      <p class="eyebrow">Engagement models</p>
      <h2 class="h-display mt-2 text-[32px] sm:text-[40px]">Dedicated teams, managed services or project-based.</h2>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {engagementModels.map((m) => <div class="card p-6"><h3 class="text-[21px] font-bold">{m.name}</h3><p class="mt-2 text-[14.5px] text-ink-600">{m.text}</p><p class="mt-4 text-[12.5px] font-semibold uppercase tracking-wider text-ink-400">Best for</p><p class="text-[14px] text-ink-800">{m.best}</p></div>)}
      </div>
      <div class="mt-12"><StatBand notes={false} /></div>
    </div>
  </section>
  <CTA />
</Base>
