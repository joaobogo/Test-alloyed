---
import Base from '../layouts/Base.astro';
---

<Base title="Thanks, we’ll be in touch | Alloyed" description="Your message reached the Alloyed team. An operations expert will reply within one business day." noindex>
  <section class="bg-ink-900 py-24 text-white">
    <div class="container-x max-w-2xl">
      <p class="eyebrow-light">Message received</p>
      <h1 class="h-display mt-3 text-[42px] text-white sm:text-[56px]">Thank you. An operations expert will reply within one business day.</h1>
      <p class="mt-5 text-[16.5px] text-white/75">Want to skip the back-and-forth? Book a 30-minute working session now.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="https://calendly.com/alloyed/intro" class="btn-ember !px-6" rel="noopener">Book a 30-minute session</a>
        <a href="/insights/case-studies/" class="btn-ghost-light !px-6">Read case studies while you wait</a>
      </div>
    </div>
  </section>
  <script>(window as any).dataLayer?.push({ event: 'lead_submitted' });</script>
</Base>
