---
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import { caseStudies, site } from '../data/site';
const featured = caseStudies.filter((c) => c.featured).slice(0, 3);
const next = [
  ['Within one business day', 'An operations expert reads your note and replies personally with a first read: where the leak usually is for teams like yours, and what we would look at first.'],
  ['A 30-minute working session', 'We map one workflow together: volumes, platforms, hand-offs, where errors and delays enter. You leave with a sized view of the team and the cost, whether or not you proceed.'],
  ['A written proposal', 'Roles, coverage hours, the accuracy target, the ramp plan and the fully loaded number. No surprise management layers, nothing you did not see in the session.'],
];
---

<Base title="Thanks, we’ll be in touch | Alloyed" description="Your message reached the Alloyed team. An operations expert will reply personally, typically within one business day." noindex>
  <section class="bg-ink-900 py-20 text-white sm:py-24">
    <div class="container-x grid grid-cols-1 gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow-light">Message received</p>
        <h1 class="h-display mt-3 max-w-[16ch] text-[40px] text-white sm:text-[56px]">Thank you. A person will reply, typically within one business day.</h1>
        <p class="mt-5 max-w-[56ch] text-[16.5px] text-white/75">Want to skip the wait? Call during business hours ({site.hours}) and ask for an operations expert.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`} class="btn-ember !px-6">Call {site.phone}</a>
          <a href="/pricing/#estimate" class="btn-ghost-light !px-6">Estimate your savings while you wait</a>
        </div>
      </div>
      <ol class="grid gap-3 lg:col-span-5" aria-label="What happens next">
        {next.map(([t, d], i) => (
          <li class="rounded-2xl border border-white/10 bg-white/[0.04] p-5">
            <p class="font-display text-[12px] font-bold tracking-widest text-ember-400">STEP {i + 1}</p>
            <h2 class="mt-1.5 font-sans text-[16.5px] font-semibold text-white">{t}</h2>
            <p class="mt-1.5 text-[14px] leading-relaxed text-white/65">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <section class="py-16 sm:py-20">
    <div class="container-x">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div><p class="eyebrow">While you wait</p><h2 class="h-display mt-2 text-[30px] sm:text-[38px]">Three engagements worth reading.</h2></div>
        <a href="/insights/case-studies/" class="btn-ghost">All {caseStudies.length} case studies</a>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-3">{featured.map((cs) => <CaseCard cs={cs} />)}</div>
    </div>
  </section>
  <script>(window as any).dataLayer?.push({ event: 'lead_submitted' });</script>
</Base>
