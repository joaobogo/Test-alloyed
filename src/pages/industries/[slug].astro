---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import CaseCard from '../../components/CaseCard.astro';
import { industries, serviceBySlug, caseBySlug, site } from '../../data/site';

export function getStaticPaths() {
  return industries.map((ind) => ({ params: { slug: ind.slug }, props: { ind } }));
}
const { ind } = Astro.props;
const svcs = ind.services.map(serviceBySlug);
const cases = ind.caseStudies.map(caseBySlug).filter(Boolean);
const schema = [{ '@context': 'https://schema.org', '@type': 'Service', name: `Operations outsourcing for ${ind.name}`, description: ind.metaDescription, provider: { '@id': `${site.url}/#organization` }, audience: { '@type': 'BusinessAudience', name: ind.name }, url: `${site.url}/industries/${ind.slug}/` }];
---

<Base title={ind.metaTitle} description={ind.metaDescription} ogImage={`/og/industries-${ind.slug}.png`} schema={schema} breadcrumbs={[{ name: 'Industries', href: '/industries/' }, { name: ind.name, href: `/industries/${ind.slug}/` }]}>
  <section class="relative isolate overflow-hidden bg-ink-900 text-white">
    <div class="absolute inset-0 -z-10 grid-bg opacity-40" aria-hidden="true"></div>
    <div class="absolute -right-32 top-0 -z-10 h-[480px] w-[480px] rounded-full bg-brand-600/30 blur-[120px]" aria-hidden="true"></div>
    <div class="container-x relative grid items-center gap-12 py-20 sm:py-24 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <nav aria-label="Breadcrumb" class="hero-in text-[13px] text-white/60" style="--d:0ms"><a href="/" class="hover:text-white">Home</a> <span class="mx-1.5">/</span> <a href="/industries/" class="hover:text-white">Industries</a> <span class="mx-1.5">/</span> <span class="text-white/80">{ind.name}</span></nav>
        <p class="eyebrow-light hero-in mt-6" style="--d:60ms">{ind.name}</p>
        <h1 class="h-display hero-in mt-3 max-w-[18ch] text-[38px] text-white sm:text-[52px]" style="--d:120ms">{ind.headline}</h1>
        <p class="hero-in mt-5 max-w-[60ch] text-[17px] leading-relaxed text-white/75" style="--d:180ms">{ind.intro}</p>
        <div class="hero-in mt-8 flex flex-col gap-3 sm:flex-row" style="--d:240ms"><a href="#contact" class="btn-ember !px-6">Talk to an operations expert</a><a href="/insights/case-studies/" class="btn-ghost-light !px-6">See the case studies</a></div>
      </div>
      <div class="hero-in lg:col-span-5" style="--d:200ms">
        <div class="tilt rounded-2xl border border-white/10 bg-ink-800/80 p-5 shadow-[0_30px_80px_-30px_rgba(0,0,0,.7)] backdrop-blur" aria-hidden="true">
          <div class="flex items-center justify-between text-[12px] font-semibold uppercase tracking-[0.14em] text-white/60"><span class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-mint-500"></span>Published outcomes</span><span class="rounded-full bg-white/5 px-2.5 py-1 font-medium normal-case tracking-normal">{ind.name}</span></div>
          <ul class="mt-4 grid gap-3">
            {ind.outcomes.map((o) => <li class="flex items-baseline justify-between gap-4 rounded-xl border border-white/10 bg-ink-900/60 px-4 py-3"><span class="h-display text-[30px] text-ember-400">{o.value}</span><span class="text-right text-[13px] leading-snug text-white/80">{o.label}</span></li>)}
          </ul>
          <div class="mt-4 flex flex-wrap gap-2">{svcs.map((s) => <span class="rounded-full border border-white/15 px-2.5 py-1 text-[11.5px] text-white/80">{s.name}</span>)}</div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow">What we see</p>
        <h2 class="h-display mt-2 text-[32px] sm:text-[40px]">The problems {ind.name.toLowerCase()} teams bring us.</h2>
        <ul class="mt-6 space-y-3">{ind.pains.map((p) => <li class="flex gap-3 text-[15.5px] text-ink-800"><svg class="mt-1 shrink-0 text-ember-500" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>{p}</li>)}</ul>
      </div>
      <div class="lg:col-span-7">
        <p class="eyebrow">How we help</p>
        <ul class="mt-4 grid gap-4 sm:grid-cols-2">
          {svcs.map((s) => <li><a href={`/services/${s.slug}/`} class="card block h-full p-6 hover:border-brand-200"><h3 class="text-[19px] font-bold">{s.name}</h3><p class="mt-2 text-[14px] text-ink-600">{s.short}</p><p class="mt-4 text-[14px] font-semibold text-brand-600">Explore →</p></a></li>)}
        </ul>
      </div>
    </div>
  </section>

  {cases.length > 0 && (
    <section class="bg-ink-50 py-20">
      <div class="container-x">
        <p class="eyebrow">Proof in {ind.name.toLowerCase()}</p>
        <h2 class="h-display mt-2 text-[32px] sm:text-[40px]">Case studies</h2>
        <div class="mt-8 grid gap-5 md:grid-cols-3">{cases.map((c) => <CaseCard cs={c!} />)}</div>
      </div>
    </section>
  )}
  <CTA interest={ind.name} />
</Base>
