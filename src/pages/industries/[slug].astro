---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import CaseCard from '../../components/CaseCard.astro';
import { industries, serviceBySlug, caseBySlug, site } from '../../data/site';

export function getStaticPaths() {
  return industries.map((ind) => ({ params: { slug: ind.slug }, props: { ind } }));
}
const { ind } = Astro.props;
const svcs = ind.services.map(serviceBySlug);
const cases = ind.caseStudies.map(caseBySlug).filter(Boolean);
const schema = [{ '@context': 'https://schema.org', '@type': 'Service', name: `Operations outsourcing for ${ind.name}`, description: ind.metaDescription, provider: { '@id': `${site.url}/#organization` }, audience: { '@type': 'BusinessAudience', name: ind.name }, url: `${site.url}/industries/${ind.slug}/` }];
---

<Base title={ind.metaTitle} description={ind.metaDescription} schema={schema} breadcrumbs={[{ name: 'Industries', href: '/industries/' }, { name: ind.name, href: `/industries/${ind.slug}/` }]}>
  <section class="relative overflow-hidden bg-ink-900 text-white">
    <div class="absolute inset-0 grid-bg opacity-40" aria-hidden="true"></div>
    <div class="container-x relative py-20 sm:py-24">
      <nav aria-label="Breadcrumb" class="text-[13px] text-white/60"><a href="/" class="hover:text-white">Home</a> <span class="mx-1.5">/</span> <a href="/industries/" class="hover:text-white">Industries</a> <span class="mx-1.5">/</span> <span class="text-white/80">{ind.name}</span></nav>
      <p class="eyebrow-light mt-6">{ind.name}</p>
      <h1 class="h-display mt-3 max-w-[18ch] text-[40px] text-white sm:text-[56px]">{ind.headline}</h1>
      <p class="mt-5 max-w-[62ch] text-[17px] leading-relaxed text-white/75">{ind.intro}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row"><a href="#contact" class="btn-ember !px-6">Talk to an operations expert</a></div>
      <ul class="mt-12 grid max-w-3xl grid-cols-3 gap-4 border-t border-white/10 pt-8">
        {ind.outcomes.map((o) => <li><p class="h-display text-[30px] text-white sm:text-[38px]">{o.value}</p><p class="mt-1 text-[13px] text-white/60">{o.label}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="py-20">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow">What we see</p>
        <h2 class="h-display mt-2 text-[32px] sm:text-[40px]">The problems {ind.name.toLowerCase()} teams bring us.</h2>
        <ul class="mt-6 space-y-3">{ind.pains.map((p) => <li class="flex gap-3 text-[15.5px] text-ink-800"><svg class="mt-1 shrink-0 text-ember-500" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>{p}</li>)}</ul>
      </div>
      <div class="lg:col-span-7">
        <p class="eyebrow">How we help</p>
        <ul class="mt-4 grid gap-4 sm:grid-cols-2">
          {svcs.map((s) => <li><a href={`/services/${s.slug}/`} class="card block h-full p-6 hover:border-brand-200"><h3 class="text-[19px] font-bold">{s.name}</h3><p class="mt-2 text-[14px] text-ink-600">{s.short}</p><p class="mt-4 text-[14px] font-semibold text-brand-600">Explore →</p></a></li>)}
        </ul>
      </div>
    </div>
  </section>

  {cases.length > 0 && (
    <section class="bg-ink-50 py-20">
      <div class="container-x">
        <p class="eyebrow">Proof in {ind.name.toLowerCase()}</p>
        <h2 class="h-display mt-2 text-[32px] sm:text-[40px]">Case studies</h2>
        <div class="mt-8 grid gap-5 md:grid-cols-3">{cases.map((c) => <CaseCard cs={c!} />)}</div>
      </div>
    </section>
  )}
  <CTA interest={ind.name} />
</Base>
