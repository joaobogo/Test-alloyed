---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import { industries } from '../../data/site';
---

<Base title="Industries We Serve: Media, Advertising, Retail Media, Financial Services | Alloyed" description="Alloyed runs operations for media companies, publishers, agencies, ad tech, retail media networks, financial services, travel brands and sports organizations." breadcrumbs={[{ name: 'Industries', href: '/industries/' }]}>
  <section class="bg-ink-900 py-20 text-white sm:py-24">
    <div class="container-x">
      <p class="eyebrow-light">Industries</p>
      <h1 class="h-display mt-3 max-w-[16ch] text-[42px] text-white sm:text-[60px]">Where volume, accuracy and deadlines collide.</h1>
      <p class="mt-5 max-w-[60ch] text-[17px] text-white/75">Two decades inside media, advertising and financial services operations means our teams arrive knowing your platforms, your seasonality and your compliance rules.</p>
    </div>
  </section>
  <section class="py-16">
    <div class="container-x grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {industries.map((ind) => (
        <a href={`/industries/${ind.slug}/`} class="card group reveal flex flex-col p-7 hover:border-brand-200">
          <h2 class="text-[24px] font-bold group-hover:text-brand-700">{ind.name}</h2>
          <p class="mt-3 text-[14.5px] leading-relaxed text-ink-600">{ind.intro}</p>
          <dl class="mt-6 grid grid-cols-3 gap-3 border-t border-ink-100 pt-5">{ind.outcomes.map((o) => <div><dd class="h-display text-[22px] text-brand-600">{o.value}</dd><dt class="text-[11.5px] text-ink-500">{o.label}</dt></div>)}</dl>
        </a>
      ))}
    </div>
  </section>
  <CTA />
</Base>
