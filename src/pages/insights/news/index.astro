---
import Base from '../../../layouts/Base.astro';
import CTA from '../../../components/CTA.astro';
import { news, formatDate } from '../../../data/content';
---

<Base title="Alloyed News: Partnerships, Leadership and Announcements" description="Press releases and announcements from Alloyed (formerly SEBPO): the management buyout, new CEO Lauren Kochan, and AI partnerships with Beam AI, SimpliSmart and Supervity." breadcrumbs={[{ name: 'Insights', href: '/insights/' }, { name: 'News', href: '/insights/news/' }]}>
  <section class="bg-ink-900 py-16 text-white sm:py-20">
    <div class="container-x">
      <p class="eyebrow-light">News</p>
      <h1 class="h-display mt-3 max-w-[18ch] text-[40px] text-white sm:text-[56px]">Announcements from Alloyed.</h1>
      <p class="mt-5 max-w-[60ch] text-[17px] text-white/75">Partnerships, leadership and company news. For press inquiries, contact <a href="mailto:press@alloyed.io" class="underline underline-offset-2">press@alloyed.io</a>.</p>
    </div>
  </section>
  <section class="py-14">
    <div class="container-x">
      <ol class="divide-y divide-ink-100 rounded-2xl border border-ink-100 bg-white">
        {news.map((a) => (
          <li>
            <a href={`/insights/news/${a.slug}/`} class="group grid gap-3 p-6 transition hover:bg-brand-50/40 sm:grid-cols-12 sm:items-start sm:gap-8 sm:p-7">
              <time datetime={a.date} class="text-[13px] font-semibold uppercase tracking-[0.12em] text-ink-500 sm:col-span-2">{formatDate(a.date, { month: 'short', day: 'numeric', year: 'numeric' })}</time>
              <div class="sm:col-span-10">
                <h2 class="text-[20px] font-bold leading-snug text-ink-900 group-hover:text-brand-700 sm:text-[22px]">{a.title}</h2>
                <p class="mt-2 text-[15px] leading-relaxed text-ink-600">{a.excerpt}</p>
                <span class="mt-3 inline-flex items-center gap-1.5 text-[14px] font-semibold text-brand-600">Read the release <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="transition group-hover:translate-x-1"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <CTA />
</Base>
