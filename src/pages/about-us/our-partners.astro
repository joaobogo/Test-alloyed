---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import LogoWall from '../../components/LogoWall.astro';
const partners = [
  ['SimpliSmart', 'Agentic AI for accelerated, end-to-end AI-powered enterprise operations.', 'Partnership announced 2026'],
  ['Supervity', 'The “AI BPO employee” for accounts payable and finance workflows.', 'Partnership announced 2026'],
  ['Beam AI', 'AI agents embedded in client operations, with human-in-the-loop governance.', 'Partnership announced 2026'],
  ['Thread AI', 'Workflow orchestration connecting people, models and systems.', 'Vetted partner'],
];
---

<Base title="AI & Automation Technology Partners | Alloyed" description="Alloyed’s vetted automation ecosystem: SimpliSmart, Supervity, Beam AI and Thread AI, tested on real client workloads before they reach you." breadcrumbs={[{ name: 'About', href: '/about-us/' }, { name: 'Technology Partners', href: '/about-us/our-partners/' }]}>
  <section class="bg-ink-900 py-20 text-white sm:py-24">
    <div class="container-x">
      <p class="eyebrow-light">Technology partners</p>
      <h1 class="h-display mt-3 max-w-[16ch] text-[42px] text-white sm:text-[58px]">A curated AI ecosystem, built on diligence.</h1>
      <p class="mt-5 max-w-[62ch] text-[17px] text-white/75">Evaluating emerging technology independently costs internal time most teams do not have. Alloyed ran a year-long, hands-on evaluation of the automation landscape so you do not have to. We tested real-world performance, ran security checks and built working relationships before adding any partner to the roster.</p>
    </div>
  </section>
  <section class="border-b border-ink-100 py-10"><div class="container-x"><LogoWall heading="Partners in the Alloyed automation ecosystem" /></div></section>
  <section class="py-20">
    <div class="container-x grid gap-5 md:grid-cols-2">
      {partners.map(([n, d, s]) => <div class="card reveal p-7"><h2 class="font-display text-[30px] font-bold tracking-tight">{n}</h2><p class="mt-2 text-[15px] text-ink-600">{d}</p><p class="mt-4 text-[12.5px] font-semibold uppercase tracking-wider text-brand-600">{s}</p></div>)}
    </div>
  </section>
  <section class="bg-ink-50 py-20">
    <div class="container-x grid gap-6 md:grid-cols-3">
      {[['Alloyed brings', ['Deep process expertise', 'Human-in-the-loop operations', 'Compliance, QA and governance', 'Scalable delivery teams']], ['Partners bring', ['AI models, agents and RAG systems', 'Workflow automation accelerators', 'Engineering, security and integration support']], ['Together', ['Faster deployment', 'Higher accuracy', 'Lower cost of ownership', 'A roadmap from manual to hybrid to automated']]].map(([t, items]) => <div class="card p-6"><h2 class="text-[21px] font-bold">{t}</h2><ul class="mt-4 space-y-2 text-[14.5px] text-ink-800">{(items as string[]).map((i) => <li class="flex gap-2.5"><span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-ember-500"></span>{i}</li>)}</ul></div>)}
    </div>
  </section>
  <CTA heading="Skip months of vendor research." sub="Tell us the workflow. We’ll tell you which partner fits, what it costs and what the pilot looks like." />
</Base>
