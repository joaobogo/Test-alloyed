---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import { locations, site } from '../../data/site';
const schema = locations.map((l) => ({ '@context': 'https://schema.org', '@type': 'Place', name: `Alloyed ${l.city}`, address: { '@type': 'PostalAddress', addressLocality: l.city, addressCountry: l.country }, containedInPlace: { '@id': `${site.url}/#organization` } }));
---

<Base title="Offshore & Nearshore Delivery Centers: El Salvador, Philippines, Bangladesh | Alloyed" description="Alloyed delivers 24/7 from four locations: US headquarters, nearshore San Salvador, and offshore Manila and Dhaka. Onshore management with global delivery." schema={schema} breadcrumbs={[{ name: 'About', href: '/about-us/' }, { name: 'Global Delivery', href: '/about-us/locations/' }]}>
  <section class="bg-ink-900 py-20 text-white sm:py-24">
    <div class="container-x">
      <p class="eyebrow-light">Global delivery</p>
      <h1 class="h-display mt-3 max-w-[16ch] text-[42px] text-white sm:text-[58px]">Offshore and nearshore delivery centers with onshore management.</h1>
      <p class="mt-5 max-w-[62ch] text-[17px] text-white/75">Strategically positioned teams give 24/7 coverage across US, European and APAC time zones, with bilingual nearshore delivery in El Salvador for real-time collaboration.</p>
      <dl class="mt-12 grid grid-cols-2 gap-6 border-t border-white/10 pt-8 sm:grid-cols-5">
        {[['4', 'Delivery locations'], ['24/7', 'Coverage'], ['20+', 'Years operating'], ['92', 'Net Promoter Score'], ['98%', 'Client retention']].map(([v, l]) => <div><dd class="h-display text-[34px] text-white">{v}</dd><dt class="text-[13px] text-white/55">{l}</dt></div>)}
      </dl>
    </div>
  </section>
  <section class="py-20">
    <div class="container-x">
      <svg viewBox="0 0 1200 420" class="mb-12 w-full rounded-2xl border border-ink-100 bg-ink-50" aria-label="Map of Alloyed delivery locations: Philadelphia, San Salvador, Manila and Dhaka" role="img">
        <defs><pattern id="dots" width="14" height="14" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.3" fill="#c7cce0"/></pattern></defs>
        <rect width="1200" height="420" fill="url(#dots)" />
        {[[300, 150, 'Philadelphia Metro, US', 'HQ'], [275, 225, 'San Salvador, El Salvador', 'Nearshore'], [1010, 235, 'Manila, Philippines', 'Offshore'], [905, 200, 'Dhaka, Bangladesh', 'Offshore']].map(([x, y, n, t]) => (
          <g>
            <line x1={300} y1={150} x2={x} y2={y} stroke="#332cf2" stroke-opacity=".35" stroke-dasharray="4 5" />
            <circle cx={x} cy={y} r="18" fill="#ff6b00" fill-opacity=".15" /><circle cx={x} cy={y} r="7" fill="#ff6b00" />
            <text x={Number(x) + 14} y={Number(y) - 12} font-family="Inter, sans-serif" font-size="14" font-weight="600" fill="#0b1020">{n}</text>
            <text x={Number(x) + 14} y={Number(y) + 6} font-family="Inter, sans-serif" font-size="12" fill="#5a6487">{t}</text>
          </g>
        ))}
      </svg>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{locations.map((l) => <li class="card reveal p-6"><p class="text-[12px] font-semibold uppercase tracking-[0.12em] text-ink-400">{l.type}</p><h2 class="mt-2 text-[24px] font-bold">{l.city}</h2><p class="text-[14px] text-ink-600">{l.country} · {l.tz}</p><p class="mt-3 text-[14px] text-ink-600">{l.note}</p></li>)}</ul>
    </div>
  </section>
  <section class="bg-ink-50 py-20">
    <div class="container-x grid gap-10 lg:grid-cols-3">
      {[['Onshore', 'US-based implementation leads, account management and executive sponsorship. Your contracts, data agreements and escalations stay in the United States.'], ['Nearshore', 'San Salvador teams work US hours in real time, bilingual in English and Spanish, ideal for customer engagement, ad ops and finance workflows that need same-day collaboration.'], ['Offshore', 'Manila and Dhaka provide follow-the-sun coverage for 24/7 operations, high-volume data work and overnight turnaround, with the cost structure that makes a ~70% advantage possible.']].map(([t, d]) => <div><h2 class="text-[26px] font-bold">{t}</h2><p class="mt-3 text-[15px] leading-relaxed text-ink-600">{d}</p></div>)}
    </div>
  </section>
  <CTA heading="Need a delivery model tailored to your region?" sub="We’ll design coverage that aligns with your time zones, language requirements and compliance needs." />
</Base>
