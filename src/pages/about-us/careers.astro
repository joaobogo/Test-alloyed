---
import Base from '../../layouts/Base.astro';
const places = [
  ['United States', 'https://www.linkedin.com/company/alloyed-io/jobs/', 'Leadership, account management and implementation roles'],
  ['El Salvador', 'https://www.linkedin.com/company/alloyed-io/jobs/', 'Bilingual nearshore operations, ad ops and finance'],
  ['Philippines', 'https://www.linkedin.com/company/alloyed-io/jobs/', 'Customer engagement and operations'],
  ['Bangladesh', 'https://www.linkedin.com/company/alloyed-io/jobs/', 'Data, ad operations and 24/7 delivery'],
];
---

<Base title="Careers at Alloyed: Build Your Career in Operations" description="Join Alloyed, formerly SEBPO: structured training, clear growth paths and a collaborative culture across the US, El Salvador, the Philippines and Bangladesh." breadcrumbs={[{ name: 'About', href: '/about-us/' }, { name: 'Careers', href: '/about-us/careers/' }]}>
  <section class="bg-ink-900 py-20 text-white sm:py-24">
    <div class="container-x">
      <p class="eyebrow-light">Careers</p>
      <h1 class="h-display mt-3 max-w-[16ch] text-[42px] text-white sm:text-[58px]">Build your career here.</h1>
      <p class="mt-5 max-w-[60ch] text-[17px] text-white/75">Great teams are built on great people. Many of ours were once clients, partners or industry veterans who experienced Alloyed and decided to join. If you are driven, curious and ready to make an impact, we want to hear from you.</p>
    </div>
  </section>
  <section class="py-20">
    <div class="container-x">
      <p class="eyebrow">Open roles by location</p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{places.map(([n, h, d]) => <li><a href={h} target="_blank" rel="noopener" class="card block h-full p-6 hover:border-brand-200"><h2 class="text-[22px] font-bold">{n}</h2><p class="mt-2 text-[14px] text-ink-600">{d}</p><p class="mt-4 text-[14px] font-semibold text-brand-600">View roles →</p></a></li>)}</ul>
    </div>
  </section>
  <section class="bg-ink-50 py-20">
    <div class="container-x">
      <p class="eyebrow">Why work here</p>
      <h2 class="h-display mt-2 text-[32px] sm:text-[40px]">Life at Alloyed</h2>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2">
        {[['Continuous learning', 'Structured training programs, certifications and mentorship to accelerate your growth.'], ['Clear growth paths', 'Defined progression tracks with transparent requirements and regular performance reviews.'], ['Collaborative culture', 'Work alongside industry experts in a supportive, team-oriented environment.'], ['Work-life balance', 'Flexible arrangements, competitive benefits and recognition programs that value your contribution.'], ['We care for our community', 'Volunteer hours, pro-bono talent and donations through our three pillars of giving: time, talent and treasure.'], ['We value our team', 'Leaders take the time to connect personally with employees and understand their motivations and strengths.']].map(([t, d]) => <li class="card p-6"><h3 class="text-[19px] font-bold">{t}</h3><p class="mt-2 text-[14.5px] text-ink-600">{d}</p></li>)}
      </ul>
    </div>
  </section>
</Base>
