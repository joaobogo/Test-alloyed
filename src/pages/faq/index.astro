---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import { faqFor as serviceFaq } from '../../components/ServiceFAQ.astro';
import { faqFor as industryFaq } from '../../components/IndustryFAQ.astro';
import { homeFaq, pricingFaq, deliveryFaq, securityFaq, companyFaq } from '../../data/faq';
import { services, industries, site } from '../../data/site';

const groups = [
  { id: 'general', name: 'Getting started', intro: 'What Alloyed does, what it costs and how an engagement begins.', items: homeFaq },
  { id: 'pricing', name: 'Pricing', intro: 'How engagements are priced and what the rate includes.', items: pricingFaq },
  { id: 'delivery', name: 'Delivery and governance', intro: 'Who runs the team, how onboarding works and how quality is held.', items: deliveryFaq },
  { id: 'security', name: 'Security and compliance', intro: 'Access, data handling and client-specific requirements.', items: securityFaq },
  { id: 'company', name: 'Company', intro: 'SEBPO, ownership, locations and careers.', items: companyFaq },
  ...services.map((s) => ({ id: s.slug, name: s.name, intro: s.short, items: serviceFaq(s), href: `/services/${s.slug}/` })),
  ...industries.map((i) => ({ id: i.slug, name: i.name, intro: i.headline, items: industryFaq(i), href: `/industries/${i.slug}/` })),
];
const all = groups.flatMap((g) => g.items);
const schema = [
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: all.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---

<Base title="Alloyed FAQ: Pricing, Delivery, Security and Services" description={`${all.length} answers about Alloyed (formerly SEBPO): what it costs, how teams are run, security and compliance, each service and each industry.`} schema={schema} breadcrumbs={[{ name: 'FAQ', href: '/faq/' }]}>
  <section class="bg-ink-900 py-16 text-white sm:py-20">
    <div class="container-x">
      <p class="eyebrow-light">Frequently asked questions</p>
      <h1 class="h-display mt-3 max-w-[16ch] text-[40px] text-white sm:text-[56px]">{all.length} straight answers.</h1>
      <p class="mt-5 max-w-[60ch] text-[17px] text-white/75">Everything buyers ask before the first call, grouped by topic. If yours is missing, an operations expert replies personally, typically within one business day.</p>
      <nav class="mt-8 flex flex-wrap gap-2" aria-label="FAQ topics">
        {groups.slice(0, 5).map((g) => <a href={`#${g.id}`} class="rounded-full border border-white/20 px-4 py-1.5 text-[13.5px] font-medium text-white/85 hover:border-white hover:text-white">{g.name}</a>)}
        <a href="#services" class="rounded-full border border-white/20 px-4 py-1.5 text-[13.5px] font-medium text-white/85 hover:border-white hover:text-white">Services</a>
        <a href="#industries" class="rounded-full border border-white/20 px-4 py-1.5 text-[13.5px] font-medium text-white/85 hover:border-white hover:text-white">Industries</a>
      </nav>
    </div>
  </section>

  <div class="container-x py-6">
    <label class="block max-w-xl"><span class="sr-only">Filter questions</span>
      <input id="faq-filter" type="search" placeholder="Filter questions, e.g. “peak season” or “AML”" class="w-full rounded-lg border border-ink-200 bg-white px-4 py-3 text-[15px] text-ink-900 placeholder:text-ink-400 focus:border-brand-600 focus:ring-2 focus:ring-brand-100" autocomplete="off" />
    </label>
    <p id="faq-count" class="mt-2 text-[13px] text-ink-500" aria-live="polite"></p>
  </div>

  {groups.map((g, gi) => (
    <>
      {gi === 5 && <div id="services" class="container-x pt-10"><p class="eyebrow">By service</p></div>}
      {gi === 5 + services.length && <div id="industries" class="container-x pt-10"><p class="eyebrow">By industry</p></div>}
      <section id={g.id} class="faq-group py-10 scroll-mt-24">
        <div class="container-x grid grid-cols-1 gap-8 lg:grid-cols-12">
          <div class="lg:col-span-4">
            <h2 class="h-display text-[26px] sm:text-[30px]">{g.name}</h2>
            <p class="mt-2 text-[14.5px] text-ink-600">{g.intro}</p>
            {'href' in g && g.href && <a href={g.href} class="mt-3 inline-flex items-center gap-1.5 text-[14px] font-semibold text-brand-600">Full page <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>}
          </div>
          <div class="divide-y divide-ink-100 rounded-2xl border border-ink-100 lg:col-span-8">
            {g.items.map((f) => (
              <details class="faq-item group p-5 sm:p-6">
                <summary class="flex cursor-pointer items-center justify-between gap-4 text-[16.5px] font-semibold text-ink-900">{f.q}
                  <svg class="shrink-0 transition group-open:rotate-45" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M9 3v12M3 9h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                </summary>
                <p class="mt-3 text-[15px] leading-relaxed text-ink-600">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    </>
  ))}

  <CTA heading="Still have a question?" sub="Ask it here. A person replies, typically within one business day, with a straight answer and, if useful, a 30-minute working session." />

  <script>
    const init = () => {
      const input = document.getElementById('faq-filter') as HTMLInputElement | null;
      const count = document.getElementById('faq-count');
      if (!input || !count) return;
      const items = [...document.querySelectorAll<HTMLDetailsElement>('.faq-item')];
      const groups = [...document.querySelectorAll<HTMLElement>('.faq-group')];
      const total = items.length;
      const apply = () => {
        const q = input.value.trim().toLowerCase();
        let shown = 0;
        items.forEach((it) => { const hit = !q || it.textContent!.toLowerCase().includes(q); it.hidden = !hit; if (hit) shown++; if (q && hit) it.open = true; });
        groups.forEach((g) => { g.hidden = ![...g.querySelectorAll<HTMLElement>('.faq-item')].some((i) => !i.hidden); });
        count.textContent = q ? `${shown} of ${total} answers match “${input.value.trim()}”` : '';
      };
      input.addEventListener('input', apply);
    };
    document.addEventListener('astro:page-load', init);
  </script>
</Base>
