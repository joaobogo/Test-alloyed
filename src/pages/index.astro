---
import Base from '../layouts/Base.astro';
import HeroArt from '../components/HeroArt.astro';
import StatBand from '../components/StatBand.astro';
import CaseCard from '../components/CaseCard.astro';
import Testimonials from '../components/Testimonials.astro';
import CTA from '../components/CTA.astro';
import { services, industries, caseStudies, proof, process, partners, site } from '../data/site';

const featured = caseStudies.filter((c) => c.featured).slice(0, 3);

const faq = [
  { q: 'What does Alloyed do?', a: 'Alloyed runs business operations for enterprise teams: ad operations, media billing and finance, AML/KYC compliance, data engineering and analytics, customer engagement and quality assurance. Dedicated teams work inside your platforms with onshore management and delivery from El Salvador, the Philippines and Bangladesh.' },
  { q: 'Is Alloyed the same company as SEBPO?', a: 'Yes. SEBPO rebranded as Alloyed in 2026 following a management buyout of the US operations. Same leadership, same clients, same 20-year delivery record, with an expanded AI and automation practice.' },
  { q: 'Who does Alloyed work with?', a: 'Media companies, publishers, advertising agencies, ad tech platforms, retail media networks, financial services firms, travel brands and sports organizations. 43% of client partnerships have lasted more than five years.' },
  { q: 'How quickly can a team start?', a: 'Discovery and implementation planning typically run two to four weeks. A named implementation lead documents your workflows, builds the team with delivery center leadership, and runs a pilot before full ramp.' },
  { q: 'Where are Alloyed teams located?', a: 'Headquarters in the Philadelphia metro area with delivery centers in San Salvador, El Salvador; Manila, Philippines; and Dhaka, Bangladesh, giving 24/7 coverage across US, European and APAC time zones.' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'Alloyed',
    url: site.url,
    description: site.description,
    parentOrganization: { '@id': `${site.url}/#organization` },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Managed operations services',
      itemListElement: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.title, url: `${site.url}/services/${s.slug}/` } })),
    },
  },
];
---

<Base
  title="Alloyed | Managed Operations & BPO for Media, Advertising & Financial Services"
  description="Alloyed (formerly SEBPO) runs ad operations, finance, compliance, data and customer-engagement workflows for enterprise teams. 20+ years, 92 NPS, 98% retention, 99.99% QA accuracy. Talk to an operations expert."
  schema={schema}
>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-ink-900 text-white">
    <div class="absolute inset-0 grid-bg opacity-50" aria-hidden="true"></div>
    <HeroArt class="absolute right-0 top-0 h-full w-[70%] opacity-90 lg:w-[58%]" />
    <div class="absolute inset-0 bg-gradient-to-r from-ink-900 via-ink-900/80 to-transparent" aria-hidden="true"></div>

    <div class="container-x relative py-24 sm:py-32 lg:py-36">
      <p class="eyebrow-light">Formerly SEBPO · Operating since 2006</p>
      <h1 class="h-display mt-5 max-w-[21ch] text-[40px] text-white sm:text-[54px] lg:text-[62px]">
        Outsourced ad operations, finance and compliance teams for media and advertising companies.
      </h1>
      <p class="mt-6 max-w-[56ch] text-[17px] leading-relaxed text-white/75 sm:text-[19px]">
        Alloyed fuses people, process and technology into dedicated teams that run your highest-volume workflows, inside your platforms, with onshore management and global delivery. Predictable performance, measured every week.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href="/contact/" class="btn-ember !px-6 !py-3.5 text-[16px]">Talk to an operations expert
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/insights/case-studies/" class="btn-ghost-light !px-6 !py-3.5 text-[16px]">See 23 case studies</a>
      </div>

      <ul class="mt-14 flex flex-wrap gap-x-8 gap-y-3 border-t border-white/10 pt-6 text-[13px] text-white/60" aria-label="Recognition">
        {proof.map((p) => (
          <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-ember-500" aria-hidden="true"></span><span class="font-medium text-white/85">{p.label}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- STATS -->
  <section class="bg-ink-50 py-16">
    <div class="container-x">
      <div class="mb-8 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">Predictable performance</p>
          <h2 class="h-display mt-2 text-[32px] sm:text-[40px]">Numbers our clients hold us to.</h2>
        </div>
        <p class="max-w-md text-[14.5px] text-ink-500">Measured across every engagement, reported to clients weekly, audited annually.</p>
      </div>
      <div class="reveal"><StatBand /></div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="py-20 sm:py-24">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow">What we run</p>
        <h2 class="h-display mt-2 text-[34px] sm:text-[44px]">Six operations practices. One accountable partner.</h2>
        <p class="mt-4 text-[16px] leading-relaxed text-ink-600">Each practice is staffed by trained specialists, governed by documented process and measured against outcome SLAs. Start with one workflow or hand off an entire function.</p>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {services.map((s, i) => (
          <a href={`/services/${s.slug}/`} class="card group reveal flex flex-col p-7 transition hover:-translate-y-0.5 hover:border-brand-200" style={`transition-delay:${i * 60}ms`}>
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-600 font-display text-[18px] font-bold">0{i + 1}</span>
            <h3 class="mt-5 text-[22px] font-bold">{s.name}</h3>
            <p class="mt-2 text-[14.5px] leading-relaxed text-ink-600">{s.short}</p>
            <p class="mt-5 flex items-baseline gap-2"><span class="h-display text-[28px] text-ember-600">{s.outcomes[0].value}</span><span class="text-[13px] text-ink-500">{s.outcomes[0].label}</span></p>
            <span class="mt-auto inline-flex items-center gap-1.5 pt-6 text-[14px] font-semibold text-brand-600">Explore {s.name.split(' ')[0].toLowerCase()} services <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="transition group-hover:translate-x-0.5"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY ALLOYED / DIFFERENTIATORS -->
  <section class="relative overflow-hidden bg-ink-900 py-20 text-white sm:py-24">
    <div class="absolute inset-0 grid-bg opacity-40" aria-hidden="true"></div>
    <div class="container-x relative grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow-light">Why Alloyed</p>
        <h2 class="h-display mt-2 text-[34px] text-white sm:text-[44px]">Delivery partners, not a service vendor.</h2>
        <p class="mt-4 text-[16px] leading-relaxed text-white/70">Most providers sell a catalog. Alloyed takes ownership of the workflow, the quality and the outcome, and treats your operations as one conversation, not a ticket queue.</p>
        <a href="/about-us/" class="btn-ghost-light mt-8">How we work</a>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-7">
        {[
          ['Process first, then automation', 'We map and fix the workflow before introducing technology. That is why our automations hold up in production: 500% throughput gains, 60% fewer errors.'],
          ['Onshore management, global delivery', 'US-based implementation and account leads; bilingual nearshore teams in El Salvador; 24/7 offshore delivery in Manila and Dhaka.'],
          ['Your platforms, your controls', 'Teams work inside your stack under least-privilege access with documented controls. 300+ platforms supported over two decades.'],
          ['Governance you can audit', 'Weekly KPI reporting, quarterly business reviews, a client success manager in every governance call. 99.99% QA accuracy is a process, not a promise.'],
          ['Vetted AI partner ecosystem', 'SimpliSmart, Supervity, Beam AI and Thread AI, tested on real client workloads before they reach you.'],
          ['Built to last', '43% of partnerships exceed five years. Our longest financial services client has been with us for two decades.'],
        ].map(([t, d]) => (
          <li class="reveal rounded-2xl border border-white/10 bg-white/[0.04] p-6">
            <h3 class="font-sans text-[16.5px] font-semibold text-white">{t}</h3>
            <p class="mt-2 text-[14px] leading-relaxed text-white/65">{d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CASE STUDIES -->
  <section class="py-20 sm:py-24">
    <div class="container-x">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <p class="eyebrow">Proof</p>
          <h2 class="h-display mt-2 text-[34px] sm:text-[44px]">Measurable outcomes, documented.</h2>
        </div>
        <a href="/insights/case-studies/" class="btn-ghost">All 23 case studies</a>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {featured.map((cs) => <div class="reveal"><CaseCard cs={cs} /></div>)}
      </div>
      <div class="mt-12 reveal"><Testimonials /></div>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="bg-ink-50 py-20 sm:py-24">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow">Industries</p>
        <h2 class="h-display mt-2 text-[34px] sm:text-[44px]">Deep in the industries where volume, accuracy and deadlines collide.</h2>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {industries.map((ind) => (
          <a href={`/industries/${ind.slug}/`} class="card group reveal p-6 transition hover:border-brand-200">
            <h3 class="text-[20px] font-bold group-hover:text-brand-700">{ind.name}</h3>
            <p class="mt-2 text-[14px] leading-relaxed text-ink-600">{ind.intro.slice(0, 120)}…</p>
            <p class="mt-4 flex items-baseline gap-2"><span class="h-display text-[24px] text-brand-600">{ind.outcomes[0].value}</span><span class="text-[13px] text-ink-500">{ind.outcomes[0].label}</span></p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="py-20 sm:py-24">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow">How delivery works</p>
        <h2 class="h-display mt-2 text-[34px] sm:text-[40px]">Three steps from intake to improvement.</h2>
        <p class="mt-4 text-[15.5px] leading-relaxed text-ink-600">We call it cognitive process orchestration: routing work, enforcing quality and aligning humans and automation for the best result.</p>
        <a href="/automation/" class="btn-primary mt-8">Our automation approach</a>
      </div>
      <ol class="grid gap-4 lg:col-span-8 sm:grid-cols-3">
        {process.map((p) => (
          <li class="reveal rounded-2xl border border-ink-100 bg-white p-6">
            <span class="font-display text-[13px] font-bold tracking-widest text-ember-700">{p.n}</span>
            <h3 class="mt-3 text-[22px] font-bold">{p.title}</h3>
            <p class="mt-2 text-[14px] leading-relaxed text-ink-600">{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PARTNERS -->
  <section class="border-y border-ink-100 bg-white py-10">
    <div class="container-x flex flex-col items-center gap-6 text-center sm:flex-row sm:justify-between sm:text-left">
      <p class="text-[14px] text-ink-500">AI and automation technology partners, vetted on real client workloads</p>
      <ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-3">
        {partners.map((p) => <li class="font-display text-[20px] font-bold tracking-tight text-ink-400">{p}</li>)}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 sm:py-24">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow">Questions</p>
        <h2 class="h-display mt-2 text-[34px] sm:text-[40px]">What buyers ask first.</h2>
      </div>
      <div class="lg:col-span-8 divide-y divide-ink-100 rounded-2xl border border-ink-100">
        {faq.map((f) => (
          <details class="group p-6">
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-[17px] font-semibold text-ink-900">
              {f.q}
              <svg class="shrink-0 transition group-open:rotate-45" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M9 3v12M3 9h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </summary>
            <p class="mt-3 text-[15px] leading-relaxed text-ink-600">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTA />
</Base>
